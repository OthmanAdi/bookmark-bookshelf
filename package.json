{
  "name": "bookmark-bookshelf",
  "version": "0.3.0",
  "private": true,
  "description": "3D bookmark manager: saved links as books on a draggable shelf. Import browser bookmarks, read saved text, share a reading list. Local-first, no account, vanilla TypeScript. The CSS shelf has no runtime dependencies, and an optional WebGL drawing uses three.js. Includes an agent skill that adds it to your project.",
  "keywords": [
    "bookmark-manager",
    "bookmarks",
    "bookshelf",
    "read-it-later",
    "reading-list",
    "css-3d",
    "webgl",
    "threejs",
    "vanilla-typescript",
    "local-first",
    "browser-bookmarks",
    "drag-and-drop",
    "agent-skills",
    "offline-first",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "OthmanAdi",
  "homepage": "https://othmanadi.github.io/bookmark-bookshelf/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OthmanAdi/bookmark-bookshelf.git"
  },
  "bugs": {
    "url": "https://github.com/OthmanAdi/bookmark-bookshelf/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
